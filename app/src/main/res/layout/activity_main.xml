<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText android:id="@+id/sender" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Sender (number ba naam, e.g. 01712345678 / bKash)" />

    <EditText android:id="@+id/msg" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Message"
        android:minLines="3" android:gravity="top" />

    <EditText android:id="@+id/delay" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Koto second pore (e.g. 30)"
        android:inputType="numberDecimal" />

    <Button android:id="@+id/pick" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Tarikh ar somoy bachho (optional, shudhu bhobishyot)" />

    <TextView android:id="@+id/picked" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" />

    <Spinner android:id="@+id/type" android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <CheckBox android:id="@+id/ins" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:checked="true"
        android:text="Messages app er inbox e-o dhukao (default SMS app lagbe)" />

    <Button android:id="@+id/go" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Schedule" />

    <View android:layout_width="match_parent" android:layout_height="20dp" />

    <TextView android:id="@+id/dstat" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" />

    <Button android:id="@+id/dset" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Set as default SMS app" />

    <Button android:id="@+id/dback" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Default SMS app fire dao (Settings)" />

    <View android:layout_width="match_parent" android:layout_height="20dp" />

    <TextView android:id="@+id/ver" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" />

    <Button android:id="@+id/upd" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Check for updates" />
</LinearLayout>
</ScrollView>
